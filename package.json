{
  "name": "geocoord",
  "version": "1.3.0",
  "description": "GeoCoord - DMS to decimal degrees coordinate converter (desktop via stlite/Electron)",
  "author": "Pedro Gonçalves (LNEG)",
  "license": "Apache-2.0",
  "main": "./build/electron/main.js",
  "scripts": {
    "dump": "dump-stlite-desktop-artifacts",
    "serve": "cross-env NODE_ENV=production electron .",
    "app:dir": "electron-builder --dir",
    "app:dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "pt.lneg.geocoord",
    "productName": "GeoCoord",
    "files": ["build/**/*"],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": ["nsis"],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@stlite/desktop": "0.102.2",
    "cross-env": "^7.0.3",
    "electron": "34.3.0",
    "electron-builder": "^25.1.8"
  },
  "stlite": {
    "desktop": {
      "files": ["app.py", "geocoord/*.py", "geocoord/*.json", "geocoord/grids/*.gsb", ".streamlit/config.toml"],
      "entrypoint": "app.py",
      "dependencies": ["numpy", "pandas", "openpyxl", "xlrd", "pyshp>=3.1.6", "pyproj"]
    }
  }
}
